{
  "name": "base",
  "version": "0.8.0",
  "description": "Build, test and lint scaffold plus the platform layer every app starts with.",
  "packageJson": {
    "scripts": {
      "dev": "vite",
      "typecheck": "tsc --noEmit",
      "lint": "eslint .",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "test": "vitest run",
      "test:watch": "vitest",
      "test:e2e": "playwright test",
      "check": "npm run format:check && npm run lint && npm run test && npm run build"
    },
    "devDependencies": {
      "@eslint/js": "^10.0.1",
      "@playwright/test": "^1.63.0",
      "@types/node": "^22.20.5",
      "eslint": "^10.12.0",
      "eslint-config-prettier": "^10.1.8",
      "globals": "^17.13.0",
      "prettier": "^3.9.9",
      "tsx": "^4.23.15",
      "typescript": "~5.9.2",
      "typescript-eslint": "^8.71.0",
      "vite": "^8.3.2",
      "vite-plugin-singlefile": "^2.3.3",
      "vitest": "^5.0.3"
    }
  }
}
