{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src", "tests", "e2e", "*.ts", "*.mjs"],
  "exclude": ["dist", "content"],
  "compilerOptions": {
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
