---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { languages, ui, path, postLang, postSlug, type Lang } from "../../../lib/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const posts = (await getCollection("posts", (p) => !p.data.draft && postLang(p.id) === lang)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base lang={lang} title={`${t.blog} | ${t.siteTitle}`}>
  <h1>{t.blog}</h1>
  {posts.length === 0 && <p>{t.noPosts}</p>}
  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={path(lang, `blog/${postSlug(post.id)}/`)}>{post.data.title}</a>
          <span class="muted"> · {post.data.date.toISOString().slice(0, 10)}</span>
        </li>
      ))
    }
  </ul>
</Base>
