---
import Base from "../../layouts/Base.astro";
import { languages, ui, path, type Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
---

<Base lang={lang} title={t.siteTitle} description={t.intro}>
  <h1>{t.welcome}</h1>
  <p>{t.intro}</p>
  <p><a href={path(lang, "blog/")}>{t.blog}</a></p>
</Base>
